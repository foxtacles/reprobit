{"$defs":{"Digest":{"additionalProperties":false,"description":"A content digest with an explicit algorithm.","properties":{"algorithm":{"const":"sha256","default":"sha256","title":"Algorithm","type":"string"},"value":{"pattern":"^[0-9a-f]{64}$","title":"Value","type":"string"}},"required":["value"],"title":"Digest","type":"object"},"ProducerNode":{"additionalProperties":false,"description":"One direct invocation of a locked producer role.\n\n``arguments`` excludes the executable.  The runtime chooses that executable\nfrom the toolchain lock, so a committed project cannot replace a producer.\nSymbolic roots are expanded without a shell immediately before execution.","properties":{"arguments":{"items":{"type":"string"},"minItems":1,"title":"Arguments","type":"array"},"depends_on":{"default":[],"items":{"pattern":"^[a-z][a-z0-9._-]{0,127}$","type":"string"},"title":"Depends On","type":"array"},"directive_inputs":{"default":[],"items":{"type":"string"},"title":"Directive Inputs","type":"array"},"id":{"pattern":"^[a-z][a-z0-9._-]{0,127}$","title":"Id","type":"string"},"inputs":{"default":[],"items":{"type":"string"},"title":"Inputs","type":"array"},"outputs":{"items":{"type":"string"},"minItems":1,"title":"Outputs","type":"array"},"owner":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$","title":"Owner","type":"string"},"role":{"$ref":"#/$defs/ProducerRole"},"target_id":{"anyOf":[{"pattern":"^[a-z][a-z0-9._-]{0,127}$","type":"string"},{"type":"null"}],"default":null,"title":"Target Id"},"timeout_seconds":{"default":900,"maximum":86400,"minimum":1,"title":"Timeout Seconds","type":"integer"}},"required":["id","role","owner","arguments","outputs"],"title":"ProducerNode","type":"object"},"ProducerRole":{"enum":["compiler","resource-compiler","librarian","linker"],"title":"ProducerRole","type":"string"}},"$id":"urn:reprobit:schema:producer-graph:2","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Portable authority for every byte-producing child process.","properties":{"extractor":{"const":"cmake-makefiles-v1","title":"Extractor","type":"string"},"nodes":{"items":{"$ref":"#/$defs/ProducerNode"},"minItems":1,"title":"Nodes","type":"array"},"path_profile_id":{"pattern":"^[a-z][a-z0-9._-]{0,127}$","title":"Path Profile Id","type":"string"},"schema_version":{"const":2,"title":"Schema Version","type":"integer"},"source_topology_digest":{"$ref":"#/$defs/Digest"},"toolchain_lock_digest":{"$ref":"#/$defs/Digest"}},"required":["schema_version","source_topology_digest","toolchain_lock_digest","path_profile_id","extractor","nodes"],"title":"ProducerGraphDocument","type":"object"}
